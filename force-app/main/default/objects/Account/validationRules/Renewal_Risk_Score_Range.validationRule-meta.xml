<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Renewal_Risk_Score_Range</fullName>
    <active>true</active>
    <description>Score must stay between 0 and 100</description>
    <errorConditionFormula>OR(Renewal_Risk_Score__c &lt; 0, Renewal_Risk_Score__c &gt; 100)</errorConditionFormula>
    <errorDisplayField>Renewal_Risk_Score__c</errorDisplayField>
    <errorMessage>Renewal Risk Score must be between 0 and 100.</errorMessage>
</ValidationRule>
