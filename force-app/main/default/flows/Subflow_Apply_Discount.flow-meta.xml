<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Calc_Discount</name>
        <label>Calc Discount</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <actionName>DiscountCalculator</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Set_Outputs</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>amount</name>
            <value>
                <elementReference>amount</elementReference>
            </value>
        </inputParameters>
        <nameSegment>DiscountCalculator</nameSegment>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_Outputs</name>
        <label>Set Outputs</label>
        <locationX>176</locationX>
        <locationY>242</locationY>
        <assignmentItems>
            <assignToReference>discountPercent</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Calc_Discount.discountPercent</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>tierName</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Calc_Discount.tierName</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>finalAmount</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Final_Amount_Formula</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <description>Middle layer: calls the DiscountCalculator Apex action (which reads Discount_Tier__mdt) and returns percent, tier and discounted amount.</description>
    <environments>Default</environments>
    <formulas>
        <name>Final_Amount_Formula</name>
        <dataType>Currency</dataType>
        <expression>{!amount} * (1 - {!Calc_Discount.discountPercent} / 100)</expression>
        <scale>4</scale>
    </formulas>
    <interviewLabel>Subflow Apply Discount {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Subflow Apply Discount</label>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Calc_Discount</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>amount</name>
        <dataType>Currency</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
    </variables>
    <variables>
        <name>discountPercent</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <scale>2</scale>
    </variables>
    <variables>
        <name>finalAmount</name>
        <dataType>Currency</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <scale>4</scale>
    </variables>
    <variables>
        <name>tierName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
