<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <customErrors>
        <name>Test_Error</name>
        <label>Test Error</label>
        <locationX>314</locationX>
        <locationY>276</locationY>
        <customErrorMessages>
            <errorMessage>Error</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <description>Top layer (Flow -&gt; Subflow -&gt; Apex -&gt; Custom Metadata). v1: writes &quot;v1|Tier|Percent|FinalAmount&quot; into Description.</description>
    <environments>Default</environments>
    <formulas>
        <name>Result_Text</name>
        <dataType>String</dataType>
        <expression>&quot;v1|&quot; &amp; {!tierNameVar} &amp; &quot;|&quot; &amp; TEXT({!discountPercentVar}) &amp; &quot;|&quot; &amp; TEXT(ROUND({!finalAmountVar}, 2))</expression>
    </formulas>
    <interviewLabel>Account Discount Trigger {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account Discount Trigger</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Account</name>
        <label>Update Account</label>
        <locationX>50</locationX>
        <locationY>384</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>Result_Text</elementReference>
            </value>
        </inputAssignments>
        <object>Account</object>
    </recordUpdates>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Calculate_Discount</targetReference>
        </connector>
        <filterFormula>AND(ISCHANGED({!$Record.AnnualRevenue}), NOT(ISBLANK({!$Record.AnnualRevenue})))</filterFormula>
        <object>Account</object>
        <recordTriggerType>Update</recordTriggerType>
        <scheduledPaths>
            <name>Schedule_path</name>
            <connector>
                <targetReference>Test_Error</targetReference>
            </connector>
            <label>Schedule path</label>
            <offsetNumber>1</offsetNumber>
            <offsetUnit>Days</offsetUnit>
            <recordField>LastModifiedDate</recordField>
            <timeSource>RecordField</timeSource>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>Calculate_Discount</name>
        <label>Calculate Discount</label>
        <locationX>50</locationX>
        <locationY>276</locationY>
        <connector>
            <targetReference>Update_Account</targetReference>
        </connector>
        <flowName>Subflow_Apply_Discount</flowName>
        <inputAssignments>
            <name>amount</name>
            <value>
                <elementReference>$Record.AnnualRevenue</elementReference>
            </value>
        </inputAssignments>
        <outputAssignments>
            <assignToReference>discountPercentVar</assignToReference>
            <name>discountPercent</name>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>finalAmountVar</assignToReference>
            <name>finalAmount</name>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>tierNameVar</assignToReference>
            <name>tierName</name>
        </outputAssignments>
    </subflows>
    <variables>
        <name>discountPercentVar</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
    </variables>
    <variables>
        <name>finalAmountVar</name>
        <dataType>Currency</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>4</scale>
    </variables>
    <variables>
        <name>tierNameVar</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
